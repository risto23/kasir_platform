PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"
GUEST_QR_SECRET="change-this-to-a-long-random-secret"
AUTH_COOKIE_SAMESITE="lax"

APP_NAME="POS Platform API"
APP_ORIGIN="http://localhost:3000"

DEFAULT_PLATFORM_SUPER_ADMIN_EMAIL="superadmin@pos.local"
DEFAULT_BUSINESS_TYPE="RETAIL"
BCRYPT_SALT_ROUNDS=10

# SMTP Email
SMTP_HOST="smtp.sumopod.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your_smtp_username"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM="noreply@yourapp.com"

# Subscription Notification Job
SUBSCRIPTION_NOTIFICATION_JOB_ENABLED=true
SUBSCRIPTION_NOTIFICATION_JOB_INTERVAL_MS=3600000