// Prisma schema - POS Platform (Phase 1-6)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Enums =====

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BusinessType {
  RESTAURANT
  RETAIL
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
}

enum OutletStatus {
  ACTIVE
  INACTIVE
}

enum PlatformRoleCode {
  SUPER_ADMIN
}

enum BusinessRoleCode {
  OWNER
  ADMIN
  CASHIER
  KITCHEN
  INVENTORY
}

enum BusinessUserStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductOutletStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum OutletTableStatus {
  ACTIVE
  INACTIVE
}

enum PromoStatus {
  ACTIVE
  INACTIVE
}

enum PromoTargetType {
  CATEGORY
  PRODUCT
  PRODUCT_NAME
  BRAND
  UNIT
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromoOutletScope {
  ALL_OUTLETS
  SELECTED_OUTLETS
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  VOID
}

enum PurchaseReturnStatus {
  DRAFT
  POSTED
  VOID
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  CANCELLED
  PARTIAL
  REFUNDED
}

enum OrderItemStatus {
  PENDING
  PROCESSING
  DONE
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  QRIS
  OTHER
}

enum SupplierInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum BusinessPermissionCode {
  BUSINESS_ROLE_VIEW
  BUSINESS_PERMISSION_VIEW
  BUSINESS_USER_VIEW
  BUSINESS_USER_CREATE
  BUSINESS_USER_UPDATE
  BUSINESS_USER_STATUS_UPDATE
  BUSINESS_USER_ASSIGN_OUTLET
  OUTLET_SCOPE_VIEW
  OUTLET_VIEW
  OUTLET_CREATE
  OUTLET_UPDATE
  OUTLET_STATUS_UPDATE
  CATEGORY_VIEW
  CATEGORY_CREATE
  CATEGORY_UPDATE
  CATEGORY_STATUS_UPDATE
  PRODUCT_VIEW
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_STATUS_UPDATE
  PRODUCT_OUTLET_VIEW
  PRODUCT_OUTLET_UPDATE
  SUPPLIER_VIEW
  SUPPLIER_CREATE
  SUPPLIER_UPDATE
  SUPPLIER_STATUS_UPDATE
  OUTLET_TABLE_VIEW
  OUTLET_TABLE_CREATE
  OUTLET_TABLE_UPDATE
  OUTLET_TABLE_STATUS_UPDATE
  PROMO_VIEW
  PROMO_CREATE
  PROMO_UPDATE
  PROMO_STATUS_UPDATE
  ORDER_VIEW
  ORDER_CREATE
  ORDER_UPDATE
  ORDER_STATUS_UPDATE
  PAYMENT_VIEW
  PAYMENT_CREATE
  PAYMENT_STATUS_UPDATE
  RECEIPT_VIEW
  INVENTORY_VIEW
  INVENTORY_STOCK_IN
  INVENTORY_STOCK_OUT
  INVENTORY_ADJUST
  REPORT_VIEW
}

enum PosChargeType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum RoundingMethod {
  NONE
  NEAREST
  CEIL
  FLOOR
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum SubscriptionInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
  VOID
  REFUNDED
}

enum SubscriptionScheduleChangeType {
  UPGRADE
  DOWNGRADE
}

enum SubscriptionScheduleChangeStatus {
  PENDING
  APPLIED
  CANCELLED
  REJECTED
}

// ===== Core Models =====

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  businessUsers   BusinessUser[]
  ownedBusinesses Business[]         @relation("BusinessOwner")
  platformRoles   UserPlatformRole[]
  auditLogs       AuditLog[]         @relation("AuditLogActorUser")

  @@index([status])
  @@map("users")
}

model PlatformRole {
  id          String           @id @default(cuid())
  code        PlatformRoleCode @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userRoles UserPlatformRole[]

  @@map("platform_roles")
}

model UserPlatformRole {
  id             String   @id @default(cuid())
  userId         String
  platformRoleId String
  createdAt      DateTime @default(now())

  platformRole PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platformRoleId])
  @@index([platformRoleId])
  @@map("user_platform_roles")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businesses BusinessFeatureFlag[]

  @@map("feature_flags")
}

model Plan {
  id                     String        @id @default(cuid())
  code                   String        @unique
  name                   String        @unique
  description            String?
  monthlyPrice           Decimal       @db.Decimal(14, 2)
  currencyCode           String        @default("IDR")
  businessType           BusinessType?
  maxOutlets             Int?
  maxUsers               Int?
  maxProducts            Int?
  maxMonthlyTransactions Int?
  isActive               Boolean       @default(true)
  isCustomPricing        Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  subscriptions       BusinessSubscription[]
  scheduleChangesFrom SubscriptionScheduleChange[] @relation("SubscriptionScheduleChangeFromPlan")
  scheduleChangesTo   SubscriptionScheduleChange[] @relation("SubscriptionScheduleChangeToPlan")

  @@index([businessType, isActive])
  @@map("plans")
}

model Business {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  businessType BusinessType
  status       BusinessStatus @default(ACTIVE)
  ownerUserId  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  ownerUser                   User?                        @relation("BusinessOwner", fields: [ownerUserId], references: [id])
  outlets                     Outlet[]
  businessUsers               BusinessUser[]
  businessFeatures            BusinessFeatureFlag[]
  categories                  Category[]
  products                    Product[]
  suppliers                   Supplier[]
  supplierProducts            SupplierProduct[]
  purchaseOrders              PurchaseOrder[]
  goodsReceipts               GoodsReceipt[]
  purchaseReturns             PurchaseReturn[]
  purchasePriceHistories      PurchasePriceHistory[]
  supplierInvoices            SupplierInvoice[]
  supplierPayments            SupplierPayment[]
  promos                      Promo[]
  orders                      Order[]
  payments                    Payment[]
  receipts                    Receipt[]
  inventoryItems              InventoryItem[]
  inventoryMovements          InventoryMovement[]
  outletPosChargeRules        OutletPosChargeRule[]
  setting                     BusinessSetting?
  subscriptions               BusinessSubscription[]
  subscriptionInvoices        SubscriptionInvoice[]
  subscriptionUsageSnapshots  SubscriptionUsageMonthly[]
  subscriptionScheduleChanges SubscriptionScheduleChange[]
  auditLogs                   AuditLog[]

  @@index([businessType])
  @@index([status])
  @@map("businesses")
}

model BusinessSubscription {
  id                 String             @id @default(cuid())
  businessId         String
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  startedAt          DateTime           @default(now())
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  graceEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  suspendedAt        DateTime?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business        Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan            Plan                         @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices        SubscriptionInvoice[]
  scheduleChanges SubscriptionScheduleChange[]

  @@index([businessId, status])
  @@index([businessId, currentPeriodEnd])
  @@index([planId])
  @@map("business_subscriptions")
}

model SubscriptionInvoice {
  id                 String                    @id @default(cuid())
  businessId         String
  subscriptionId     String
  invoiceNumber      String
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  subtotal           Decimal                   @default(0) @db.Decimal(14, 2)
  taxAmount          Decimal                   @default(0) @db.Decimal(14, 2)
  totalAmount        Decimal                   @default(0) @db.Decimal(14, 2)
  status             SubscriptionInvoiceStatus @default(DRAFT)
  dueDate            DateTime
  issuedAt           DateTime?
  paidAt             DateTime?
  voidedAt           DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription BusinessSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments     SubscriptionPayment[]

  @@unique([businessId, invoiceNumber])
  @@unique([subscriptionId, billingPeriodStart, billingPeriodEnd])
  @@index([businessId, status, dueDate])
  @@index([subscriptionId, status])
  @@map("subscription_invoices")
}

model SubscriptionPayment {
  id              String                    @id @default(cuid())
  invoiceId       String
  method          PaymentMethod
  amount          Decimal                   @db.Decimal(14, 2)
  status          SubscriptionPaymentStatus @default(PENDING)
  referenceNumber String?
  paidAt          DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, status])
  @@index([paidAt])
  @@map("subscription_payments")
}

model SubscriptionUsageMonthly {
  id               String   @id @default(cuid())
  businessId       String
  yearMonth        String
  outletCount      Int      @default(0)
  userCount        Int      @default(0)
  productCount     Int      @default(0)
  transactionCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, yearMonth])
  @@index([yearMonth])
  @@map("subscription_usage_monthly")
}

model SubscriptionScheduleChange {
  id             String                           @id @default(cuid())
  businessId     String
  subscriptionId String?
  fromPlanId     String
  toPlanId       String
  type           SubscriptionScheduleChangeType
  effectiveAt    DateTime
  status         SubscriptionScheduleChangeStatus @default(PENDING)
  requestedAt    DateTime                         @default(now())
  processedAt    DateTime?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription BusinessSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  fromPlan     Plan                  @relation("SubscriptionScheduleChangeFromPlan", fields: [fromPlanId], references: [id], onDelete: Restrict)
  toPlan       Plan                  @relation("SubscriptionScheduleChangeToPlan", fields: [toPlanId], references: [id], onDelete: Restrict)

  @@index([businessId, status, effectiveAt])
  @@index([subscriptionId])
  @@index([fromPlanId])
  @@index([toPlanId])
  @@map("subscription_schedule_changes")
}

model Outlet {
  id         String       @id @default(cuid())
  businessId String
  name       String
  code       String
  address    String?
  phone      String?
  status     OutletStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  business               Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessUserAccesses   BusinessUserOutletAccess[]
  productOutletSettings  ProductOutletSetting[]
  tables                 OutletTable[]
  purchaseOrders         PurchaseOrder[]
  goodsReceipts          GoodsReceipt[]
  purchaseReturns        PurchaseReturn[]
  purchasePriceHistories PurchasePriceHistory[]
  supplierInvoices       SupplierInvoice[]
  supplierPayments       SupplierPayment[]
  orders                 Order[]
  payments               Payment[]
  receipts               Receipt[]
  promoOutlets           PromoOutlet[]
  inventoryItems         InventoryItem[]
  inventoryMovements     InventoryMovement[]
  roundingSetting        OutletRoundingSetting?
  outletPosChargeRules   OutletPosChargeRule[]
  setting                OutletSetting?
  receiptSetting         OutletReceiptSetting?
  auditLogs              AuditLog[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("outlets")
}

model BusinessRole {
  id          String           @id @default(cuid())
  code        BusinessRoleCode @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rolePermissions BusinessRolePermission[]
  businessUsers   BusinessUser[]

  @@map("business_roles")
}

model BusinessPermission {
  id          String                 @id @default(cuid())
  code        BusinessPermissionCode @unique
  name        String
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  rolePermissions BusinessRolePermission[]

  @@map("business_permissions")
}

model BusinessRolePermission {
  id                   String   @id @default(cuid())
  businessRoleId       String
  businessPermissionId String
  createdAt            DateTime @default(now())

  businessPermission BusinessPermission @relation(fields: [businessPermissionId], references: [id], onDelete: Cascade)
  businessRole       BusinessRole       @relation(fields: [businessRoleId], references: [id], onDelete: Cascade)

  @@unique([businessRoleId, businessPermissionId])
  @@index([businessPermissionId])
  @@map("business_role_permissions")
}

model BusinessUser {
  id                 String             @id @default(cuid())
  businessId         String
  userId             String
  businessRoleId     String
  isPrimary          Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  hasAllOutletAccess Boolean            @default(false)
  status             BusinessUserStatus @default(ACTIVE)

  outletAccesses            BusinessUserOutletAccess[]
  business                  Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessRole              BusinessRole               @relation(fields: [businessRoleId], references: [id])
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdOrders             Order[]                    @relation("OrderCreatedByBusinessUser")
  receivedPayments          Payment[]                  @relation("PaymentReceivedByBusinessUser")
  createdInventoryMovements InventoryMovement[]        @relation("InventoryMovementCreatedByBusinessUser")
  auditLogs                 AuditLog[]                 @relation("AuditLogActorBusinessUser")

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessRoleId])
  @@index([businessId, status])
  @@map("business_users")
}

model BusinessUserOutletAccess {
  id             String   @id @default(cuid())
  businessUserId String
  outletId       String
  createdAt      DateTime @default(now())

  businessUser BusinessUser @relation(fields: [businessUserId], references: [id], onDelete: Cascade)
  outlet       Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([businessUserId, outletId])
  @@index([outletId])
  @@map("business_user_outlet_accesses")
}

model BusinessFeatureFlag {
  id            String   @id @default(cuid())
  businessId    String
  featureFlagId String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([businessId, featureFlagId])
  @@index([featureFlagId])
  @@map("business_feature_flags")
}

model Category {
  id          String         @id @default(cuid())
  businessId  String
  name        String
  code        String
  description String?
  sortOrder   Int            @default(0)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]
  promos   Promo[]

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@index([businessId, status])
  @@index([businessId, sortOrder])
  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  businessId  String
  categoryId  String?
  name        String
  code        String
  sku         String?
  description String?
  imageUrl    String?
  basePrice   Decimal       @db.Decimal(14, 2)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  brand       String?
  unit        String?
  barcode     String?

  business               Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category               Category?              @relation(fields: [categoryId], references: [id])
  promos                 Promo[]
  purchaseOrderItems     PurchaseOrderItem[]
  goodsReceiptItems      GoodsReceiptItem[]
  purchaseReturnItems    PurchaseReturnItem[]
  purchasePriceHistories PurchasePriceHistory[]
  supplierProducts       SupplierProduct[]
  orderItems             OrderItem[]
  productOutletSettings  ProductOutletSetting[]
  inventoryItems         InventoryItem[]
  inventoryMovements     InventoryMovement[]

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, status])
  @@index([businessId, categoryId])
  @@index([businessId, barcode])
  @@index([businessId, name])
  @@index([businessId, brand])
  @@index([businessId, unit])
  @@map("products")
}

model Supplier {
  id              String         @id @default(cuid())
  businessId      String
  code            String
  name            String
  status          SupplierStatus @default(ACTIVE)
  phone           String?
  email           String?
  address         String?
  paymentTermDays Int?
  taxNumber       String?
  notes           String?
  leadTimeDays    Int?
  isPreferred     Boolean        @default(false)
  lastOrderAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  business               Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierProducts       SupplierProduct[]
  purchaseOrders         PurchaseOrder[]
  goodsReceipts          GoodsReceipt[]
  purchaseReturns        PurchaseReturn[]
  purchasePriceHistories PurchasePriceHistory[]
  supplierInvoices       SupplierInvoice[]
  supplierPayments       SupplierPayment[]

  @@unique([businessId, code])
  @@unique([businessId, name])
  @@index([businessId, status])
  @@index([businessId, isPreferred])
  @@map("suppliers")
}

model PurchaseOrder {
  id                      String              @id @default(cuid())
  businessId              String
  outletId                String
  supplierId              String
  createdByBusinessUserId String
  poNumber                String              @unique
  orderDate               DateTime
  expectedDate            DateTime?
  notes                   String?
  status                  PurchaseOrderStatus @default(DRAFT)
  subtotal                Decimal             @default(0) @db.Decimal(14, 2)
  totalAmount             Decimal             @default(0) @db.Decimal(14, 2)
  submittedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  business               Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet                 Outlet                 @relation(fields: [outletId], references: [id], onDelete: Cascade)
  supplier               Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items                  PurchaseOrderItem[]
  goodsReceipts          GoodsReceipt[]
  purchasePriceHistories PurchasePriceHistory[]
  supplierInvoices       SupplierInvoice[]

  @@index([businessId, outletId, status])
  @@index([businessId, supplierId])
  @@index([outletId, orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  productId        String
  productName      String
  productCode      String?
  productSku       String?
  productBarcode   String?
  unit             String?
  quantityOrdered  Decimal  @db.Decimal(14, 3)
  quantityReceived Decimal  @default(0) @db.Decimal(14, 3)
  unitCost         Decimal  @db.Decimal(14, 2)
  lineSubtotal     Decimal  @default(0) @db.Decimal(14, 2)
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder          PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product                Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  goodsReceiptItems      GoodsReceiptItem[]
  purchasePriceHistories PurchasePriceHistory[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                      String             @id @default(cuid())
  businessId              String
  outletId                String
  supplierId              String
  purchaseOrderId         String?
  createdByBusinessUserId String
  postedByBusinessUserId  String?
  receiptNumber           String             @unique
  receiptDate             DateTime
  supplierInvoiceNumber   String?
  notes                   String?
  status                  GoodsReceiptStatus @default(DRAFT)
  subtotal                Decimal            @default(0) @db.Decimal(14, 2)
  totalAmount             Decimal            @default(0) @db.Decimal(14, 2)
  postedAt                DateTime?
  voidedAt                DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  business               Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet                 Outlet                 @relation(fields: [outletId], references: [id], onDelete: Cascade)
  supplier               Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder          PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  items                  GoodsReceiptItem[]
  purchaseReturns        PurchaseReturn[]
  purchasePriceHistories PurchasePriceHistory[]
  supplierInvoice        SupplierInvoice?

  @@index([businessId, outletId, status])
  @@index([businessId, supplierId])
  @@index([purchaseOrderId])
  @@index([outletId, receiptDate])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String   @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String?
  productId           String
  productName         String
  productCode         String?
  productSku          String?
  productBarcode      String?
  unit                String?
  quantityReceived    Decimal  @db.Decimal(14, 3)
  quantityAccepted    Decimal  @db.Decimal(14, 3)
  quantityRejected    Decimal  @default(0) @db.Decimal(14, 3)
  quantityReturned    Decimal  @default(0) @db.Decimal(14, 3)
  unitCost            Decimal  @db.Decimal(14, 2)
  lineSubtotal        Decimal  @default(0) @db.Decimal(14, 2)
  note                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  goodsReceipt         GoodsReceipt          @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem    PurchaseOrderItem?    @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  product              Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchasePriceHistory PurchasePriceHistory?
  purchaseReturnItems  PurchaseReturnItem[]

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([productId])
  @@map("goods_receipt_items")
}

model PurchasePriceHistory {
  id                  String   @id @default(cuid())
  businessId          String
  outletId            String
  supplierId          String
  productId           String
  goodsReceiptId      String
  goodsReceiptItemId  String   @unique
  purchaseOrderId     String?
  purchaseOrderItemId String?
  effectiveDate       DateTime
  quantity            Decimal  @db.Decimal(14, 3)
  unitCost            Decimal  @db.Decimal(14, 2)
  createdAt           DateTime @default(now())

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet            Outlet             @relation(fields: [outletId], references: [id], onDelete: Cascade)
  supplier          Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  goodsReceipt      GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  goodsReceiptItem  GoodsReceiptItem   @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Cascade)
  purchaseOrder     PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  @@index([businessId, outletId, effectiveDate])
  @@index([businessId, productId, effectiveDate])
  @@index([businessId, supplierId, effectiveDate], map: "purchase_price_histories_businessId_supplierId_effectiveDate_id")
  @@index([goodsReceiptId])
  @@index([purchaseOrderId])
  @@index([purchaseOrderItemId])
  @@map("purchase_price_histories")
}

