generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id @default(cuid())
  fullName        String
  email           String             @unique
  passwordHash    String
  status          UserStatus         @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  businessUsers   BusinessUser[]
  ownedBusinesses Business[]         @relation("BusinessOwner")
  platformRoles   UserPlatformRole[]

  @@index([status])
  @@map("users")
}

model PlatformRole {
  id          String             @id @default(cuid())
  code        PlatformRoleCode   @unique
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  userRoles   UserPlatformRole[]

  @@map("platform_roles")
}

model UserPlatformRole {
  id             String       @id @default(cuid())
  userId         String
  platformRoleId String
  createdAt      DateTime     @default(now())
  platformRole   PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platformRoleId])
  @@index([platformRoleId])
  @@map("user_platform_roles")
}

model FeatureFlag {
  id          String                @id @default(cuid())
  key         String                @unique
  name        String
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  businesses  BusinessFeatureFlag[]

  @@map("feature_flags")
}

model Business {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  businessType         BusinessType
  status               BusinessStatus        @default(ACTIVE)
  ownerUserId          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  businessFeatures     BusinessFeatureFlag[]
  businessUsers        BusinessUser[]
  ownerUser            User?                 @relation("BusinessOwner", fields: [ownerUserId], references: [id])
  categories           Category[]
  inventory_items      inventory_items[]
  inventory_movements  inventory_movements[]
  orders               Order[]
  outlets              Outlet[]
  payments             Payment[]
  products             Product[]
  promos               Promo[]
  receipts             Receipt[]
  outletPosChargeRules OutletPosChargeRule[]

  @@index([businessType])
  @@index([status])
  @@map("businesses")
}

model Outlet {
  id                    String                     @id @default(cuid())
  businessId            String
  name                  String
  code                  String
  address               String?
  phone                 String?
  status                OutletStatus               @default(ACTIVE)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  businessUserAccesses  BusinessUserOutletAccess[]
  inventory_items       inventory_items[]
  inventory_movements   inventory_movements[]
  orders                Order[]
  tables                OutletTable[]
  business              Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments              Payment[]
  productOutletSettings ProductOutletSetting[]
  promoOutlets          PromoOutlet[]
  receipts              Receipt[]
  roundingSetting       OutletRoundingSetting?
  outletPosChargeRules  OutletPosChargeRule[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("outlets")
}

model BusinessRole {
  id              String                   @id @default(cuid())
  code            BusinessRoleCode         @unique
  name            String
  description     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  rolePermissions BusinessRolePermission[]
  businessUsers   BusinessUser[]

  @@map("business_roles")
}

model BusinessPermission {
  id              String                   @id @default(cuid())
  code            BusinessPermissionCode   @unique
  name            String
  description     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  rolePermissions BusinessRolePermission[]

  @@map("business_permissions")
}

model BusinessRolePermission {
  id                   String             @id @default(cuid())
  businessRoleId       String
  businessPermissionId String
  createdAt            DateTime           @default(now())
  businessPermission   BusinessPermission @relation(fields: [businessPermissionId], references: [id], onDelete: Cascade)
  businessRole         BusinessRole       @relation(fields: [businessRoleId], references: [id], onDelete: Cascade)

  @@unique([businessRoleId, businessPermissionId])
  @@index([businessPermissionId])
  @@map("business_role_permissions")
}

model BusinessUser {
  id                  String                     @id @default(cuid())
  businessId          String
  userId              String
  businessRoleId      String
  isPrimary           Boolean                    @default(false)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  hasAllOutletAccess  Boolean                    @default(false)
  status              BusinessUserStatus         @default(ACTIVE)
  outletAccesses      BusinessUserOutletAccess[]
  business            Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessRole        BusinessRole               @relation(fields: [businessRoleId], references: [id])
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory_movements inventory_movements[]
  createdOrders       Order[]                    @relation("OrderCreatedByBusinessUser")
  receivedPayments    Payment[]                  @relation("PaymentReceivedByBusinessUser")

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessRoleId])
  @@index([businessId, status])
  @@map("business_users")
}

model BusinessUserOutletAccess {
  id             String       @id @default(cuid())
  businessUserId String
  outletId       String
  createdAt      DateTime     @default(now())
  businessUser   BusinessUser @relation(fields: [businessUserId], references: [id], onDelete: Cascade)
  outlet         Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([businessUserId, outletId])
  @@index([outletId])
  @@map("business_user_outlet_accesses")
}

model BusinessFeatureFlag {
  id            String      @id @default(cuid())
  businessId    String
  featureFlagId String
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([businessId, featureFlagId])
  @@index([featureFlagId])
  @@map("business_feature_flags")
}

model Category {
  id          String         @id @default(cuid())
  businessId  String
  name        String
  code        String
  description String?
  sortOrder   Int            @default(0)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]
  promos      Promo[]

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@index([businessId, status])
  @@index([businessId, sortOrder])
  @@map("categories")
}

model Product {
  id                    String                 @id @default(cuid())
  businessId            String
  categoryId            String?
  name                  String
  code                  String
  sku                   String?
  description           String?
  imageUrl              String?
  basePrice             Decimal                @db.Decimal(14, 2)
  status                ProductStatus          @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  brand                 String?
  unit                  String?
  barcode               String?
  inventory_items       inventory_items[]
  inventory_movements   inventory_movements[]
  orderItems            OrderItem[]
  productOutletSettings ProductOutletSetting[]
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category              Category?              @relation(fields: [categoryId], references: [id])
  promos                Promo[]

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, status])
  @@index([businessId, categoryId])
  @@index([businessId, barcode])
  @@index([businessId, name])
  @@index([businessId, brand])
  @@index([businessId, unit])
  @@map("products")
}

model ProductOutletSetting {
  id            String              @id @default(cuid())
  productId     String
  outletId      String
  status        ProductOutletStatus @default(ACTIVE)
  isAvailable   Boolean             @default(true)
  priceOverride Decimal?            @db.Decimal(14, 2)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  outlet        Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, outletId])
  @@index([outletId, status])
  @@index([productId, status])
  @@map("product_outlet_settings")
}

model OutletTable {
  id        String            @id @default(cuid())
  outletId  String
  name      String
  code      String
  capacity  Int?
  status    OutletTableStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  orders    Order[]
  outlet    Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, code])
  @@unique([outletId, name])
  @@index([outletId, status])
  @@map("outlet_tables")
}

model Order {
  id                      String        @id @default(cuid())
  businessId              String
  outletId                String
  createdByBusinessUserId String
  tableId                 String?
  orderNumber             String        @unique
  notes                   String?
  status                  OrderStatus   @default(DRAFT)
  paymentStatus           PaymentStatus @default(UNPAID)
  subtotal                Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount          Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount               Decimal       @default(0) @db.Decimal(14, 2)
  serviceChargeAmount     Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount             Decimal       @default(0) @db.Decimal(14, 2)
  submittedAt             DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  items                   OrderItem[]
  business                Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByBusinessUser   BusinessUser  @relation("OrderCreatedByBusinessUser", fields: [createdByBusinessUserId], references: [id])
  outlet                  Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  table                   OutletTable?  @relation(fields: [tableId], references: [id])
  payments                Payment[]
  receipt                 Receipt?

  @@index([businessId, outletId, status])
  @@index([businessId, outletId, paymentStatus])
  @@index([outletId, createdAt])
  @@index([createdByBusinessUserId])
  @@index([tableId])
  @@index([businessId, createdAt], map: "orders_business_createdAt_idx")
  @@index([businessId, outletId, createdAt], map: "orders_business_outlet_createdAt_idx")
  @@map("orders")
}

model OrderItem {
  id                 String          @id @default(cuid())
  orderId            String
  productId          String
  productName        String
  productCode        String?
  productSku         String?
  productBarcode     String?
  unitPrice          Decimal         @db.Decimal(14, 2)
  quantity           Decimal         @default(1) @db.Decimal(14, 2)
  note               String?
  lineSubtotal       Decimal         @default(0) @db.Decimal(14, 2)
  lineDiscountAmount Decimal         @default(0) @db.Decimal(14, 2)
  lineTotal          Decimal         @default(0) @db.Decimal(14, 2)
  status             OrderItemStatus @default(PENDING)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id])

  @@index([orderId, status])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                       String        @id @default(cuid())
  orderId                  String
  businessId               String
  outletId                 String
  receivedByBusinessUserId String
  paymentNumber            String        @unique
  method                   PaymentMethod @default(CASH)
  status                   PaymentStatus @default(PAID)
  amountPaid               Decimal       @db.Decimal(14, 2)
  amountTendered           Decimal?      @db.Decimal(14, 2)
  changeAmount             Decimal       @default(0) @db.Decimal(14, 2)
  note                     String?
  paidAt                   DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  business                 Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order                    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  outlet                   Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  receivedByBusinessUser   BusinessUser  @relation("PaymentReceivedByBusinessUser", fields: [receivedByBusinessUserId], references: [id])
  receipt                  Receipt?

  @@index([orderId])
  @@index([businessId, outletId, status])
  @@index([outletId, paidAt])
  @@index([receivedByBusinessUserId])
  @@map("payments")
}

model Receipt {
  id              String    @id @default(cuid())
  orderId         String    @unique
  paymentId       String?   @unique
  businessId      String
  outletId        String
  receiptNumber   String    @unique
  businessName    String
  outletName      String
  outletAddress   String?
  issuedAt        DateTime
  printedAt       DateTime?
  contentSnapshot Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  outlet          Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  payment         Payment?  @relation(fields: [paymentId], references: [id])

  @@index([businessId, outletId, issuedAt])
  @@index([outletId, issuedAt])
  @@map("receipts")
}

model Promo {
  id              String            @id @default(cuid())
  businessId      String
  name            String
  description     String?
  targetType      PromoTargetType
  categoryId      String?
  productId       String?
  targetTextValue String?
  discountType    PromoDiscountType
  discountValue   Decimal           @db.Decimal(14, 2)
  startDate       DateTime
  endDate         DateTime
  startTime       String
  endTime         String
  status          PromoStatus       @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  outletScope     PromoOutletScope  @default(ALL_OUTLETS)
  promoOutlets    PromoOutlet[]
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category        Category?         @relation(fields: [categoryId], references: [id])
  product         Product?          @relation(fields: [productId], references: [id])

  @@index([businessId, status])
  @@index([businessId, targetType])
  @@index([businessId, startDate, endDate])
  @@index([businessId, outletScope])
  @@index([categoryId])
  @@index([productId])
  @@map("promos")
}

model PromoOutlet {
  id        String   @id @default(cuid())
  promoId   String
  outletId  String
  createdAt DateTime @default(now())
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  promo     Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@unique([promoId, outletId])
  @@index([promoId])
  @@index([outletId])
  @@map("promo_outlets")
}

model inventory_items {
  id                  String                @id
  businessId          String
  outletId            String
  productId           String
  stockOnHand         Decimal               @default(0) @db.Decimal(14, 3)
  minimumStock        Decimal?              @db.Decimal(14, 3)
  lastMovementAt      DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  businesses          Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlets             Outlet                @relation(fields: [outletId], references: [id], onDelete: Cascade)
  products            Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory_movements inventory_movements[]

  @@unique([productId, outletId])
  @@index([businessId, outletId])
  @@index([productId])
}

model inventory_movements {
  id                      String                @id
  businessId              String
  outletId                String
  productId               String
  inventoryItemId         String
  type                    InventoryMovementType
  quantity                Decimal               @db.Decimal(14, 3)
  note                    String?
  referenceType           String?
  referenceId             String?
  createdByBusinessUserId String?
  createdAt               DateTime              @default(now())
  businesses              Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  business_users          BusinessUser?         @relation(fields: [createdByBusinessUserId], references: [id])
  inventory_items         inventory_items       @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  outlets                 Outlet                @relation(fields: [outletId], references: [id], onDelete: Cascade)
  products                Product               @relation(fields: [productId], references: [id])

  @@index([businessId, outletId])
  @@index([createdAt])
  @@index([productId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BusinessType {
  RESTAURANT
  RETAIL
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
}

enum OutletStatus {
  ACTIVE
  INACTIVE
}

enum PlatformRoleCode {
  SUPER_ADMIN
}

enum BusinessRoleCode {
  OWNER
  ADMIN
  CASHIER
  KITCHEN
  INVENTORY
}

enum BusinessUserStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductOutletStatus {
  ACTIVE
  INACTIVE
}

enum OutletTableStatus {
  ACTIVE
  INACTIVE
}

enum PromoStatus {
  ACTIVE
  INACTIVE
}

enum PromoTargetType {
  CATEGORY
  PRODUCT
  PRODUCT_NAME
  BRAND
  UNIT
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromoOutletScope {
  ALL_OUTLETS
  SELECTED_OUTLETS
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  CANCELLED
  PARTIAL
  REFUNDED
}

enum OrderItemStatus {
  PENDING
  PROCESSING
  DONE
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  QRIS
  OTHER
}

enum BusinessPermissionCode {
  BUSINESS_ROLE_VIEW
  BUSINESS_PERMISSION_VIEW
  BUSINESS_USER_VIEW
  BUSINESS_USER_CREATE
  BUSINESS_USER_UPDATE
  BUSINESS_USER_STATUS_UPDATE
  BUSINESS_USER_ASSIGN_OUTLET
  OUTLET_SCOPE_VIEW
  OUTLET_VIEW
  OUTLET_CREATE
  OUTLET_UPDATE
  OUTLET_STATUS_UPDATE
  CATEGORY_VIEW
  CATEGORY_CREATE
  CATEGORY_UPDATE
  CATEGORY_STATUS_UPDATE
  PRODUCT_VIEW
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_STATUS_UPDATE
  PRODUCT_OUTLET_VIEW
  PRODUCT_OUTLET_UPDATE
  OUTLET_TABLE_VIEW
  OUTLET_TABLE_CREATE
  OUTLET_TABLE_UPDATE
  OUTLET_TABLE_STATUS_UPDATE
  PROMO_VIEW
  PROMO_CREATE
  PROMO_UPDATE
  PROMO_STATUS_UPDATE
  ORDER_VIEW
  ORDER_CREATE
  ORDER_UPDATE
  ORDER_STATUS_UPDATE
  PAYMENT_VIEW
  PAYMENT_CREATE
  PAYMENT_STATUS_UPDATE
  RECEIPT_VIEW
  INVENTORY_VIEW
  INVENTORY_STOCK_IN
  INVENTORY_STOCK_OUT
  INVENTORY_ADJUST
  REPORT_VIEW
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum PosChargeType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum RoundingMethod {
  NONE
  NEAREST
  CEIL
  FLOOR
}

model OutletPosChargeRule {
  id         String        @id @default(cuid())
  businessId String
  outletId   String
  key        String
  label      String
  type       PosChargeType
  value      Decimal       @db.Decimal(14, 2)
  enabled    Boolean       @default(true)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, key])
  @@index([businessId, outletId])
  @@map("outlet_pos_charge_rules")
}

model OutletRoundingSetting {
  id        String         @id @default(cuid())
  outletId  String         @unique
  method    RoundingMethod @default(CEIL)
  unit      Int            @default(100)
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId])
  @@map("outlet_rounding_settings")
}
