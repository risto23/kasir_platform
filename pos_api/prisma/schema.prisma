generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BusinessType {
  RESTAURANT
  RETAIL
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
}

enum OutletStatus {
  ACTIVE
  INACTIVE
}

enum PlatformRoleCode {
  SUPER_ADMIN
}

enum BusinessRoleCode {
  OWNER
  ADMIN
  CASHIER
  KITCHEN
  INVENTORY
}

enum BusinessUserStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductOutletStatus {
  ACTIVE
  INACTIVE
}

enum OutletTableStatus {
  ACTIVE
  INACTIVE
}

enum PromoStatus {
  ACTIVE
  INACTIVE
}

enum PromoTargetType {
  CATEGORY
  PRODUCT
  PRODUCT_NAME
  BRAND
  UNIT
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum BusinessPermissionCode {
  BUSINESS_ROLE_VIEW
  BUSINESS_PERMISSION_VIEW

  BUSINESS_USER_VIEW
  BUSINESS_USER_CREATE
  BUSINESS_USER_UPDATE
  BUSINESS_USER_STATUS_UPDATE
  BUSINESS_USER_ASSIGN_OUTLET

  OUTLET_SCOPE_VIEW

  OUTLET_VIEW
  OUTLET_CREATE
  OUTLET_UPDATE
  OUTLET_STATUS_UPDATE

  CATEGORY_VIEW
  CATEGORY_CREATE
  CATEGORY_UPDATE
  CATEGORY_STATUS_UPDATE

  PRODUCT_VIEW
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_STATUS_UPDATE

  PRODUCT_OUTLET_VIEW
  PRODUCT_OUTLET_UPDATE

  PROMO_VIEW
  PROMO_CREATE
  PROMO_UPDATE
  PROMO_STATUS_UPDATE

  OUTLET_TABLE_VIEW
  OUTLET_TABLE_CREATE
  OUTLET_TABLE_UPDATE
  OUTLET_TABLE_STATUS_UPDATE
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  platformRoles   UserPlatformRole[]
  businessUsers   BusinessUser[]
  ownedBusinesses Business[]         @relation("BusinessOwner")

  @@map("users")
}

model PlatformRole {
  id          String           @id @default(cuid())
  code        PlatformRoleCode @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userRoles UserPlatformRole[]

  @@map("platform_roles")
}

model UserPlatformRole {
  id             String   @id @default(cuid())
  userId         String
  platformRoleId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformRole PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)

  @@unique([userId, platformRoleId])
  @@map("user_platform_roles")
}

model Business {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  businessType BusinessType
  status       BusinessStatus @default(ACTIVE)
  ownerUserId  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  ownerUser        User?                 @relation("BusinessOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  outlets          Outlet[]
  businessUsers    BusinessUser[]
  businessFeatures BusinessFeatureFlag[]
  categories       Category[]
  products         Product[]
  promos           Promo[]

  @@index([businessType])
  @@index([status])
  @@map("businesses")
}

model Outlet {
  id         String       @id @default(cuid())
  businessId String
  name       String
  code       String
  address    String?
  phone      String?
  status     OutletStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  business              Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessUserAccesses  BusinessUserOutletAccess[]
  productOutletSettings ProductOutletSetting[]
  tables                OutletTable[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("outlets")
}

model BusinessRole {
  id          String           @id @default(cuid())
  code        BusinessRoleCode @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  businessUsers   BusinessUser[]
  rolePermissions BusinessRolePermission[]

  @@map("business_roles")
}

model BusinessPermission {
  id          String                 @id @default(cuid())
  code        BusinessPermissionCode @unique
  name        String
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  rolePermissions BusinessRolePermission[]

  @@map("business_permissions")
}

model BusinessRolePermission {
  id                   String   @id @default(cuid())
  businessRoleId       String
  businessPermissionId String
  createdAt            DateTime @default(now())

  businessRole       BusinessRole       @relation(fields: [businessRoleId], references: [id], onDelete: Cascade)
  businessPermission BusinessPermission @relation(fields: [businessPermissionId], references: [id], onDelete: Cascade)

  @@unique([businessRoleId, businessPermissionId])
  @@index([businessPermissionId])
  @@map("business_role_permissions")
}

model BusinessUser {
  id                 String             @id @default(cuid())
  businessId         String
  userId             String
  businessRoleId     String
  status             BusinessUserStatus @default(ACTIVE)
  isPrimary          Boolean            @default(false)
  hasAllOutletAccess Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business       Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessRole   BusinessRole               @relation(fields: [businessRoleId], references: [id], onDelete: Restrict)
  outletAccesses BusinessUserOutletAccess[]

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessRoleId])
  @@index([businessId, status])
  @@map("business_users")
}

model BusinessUserOutletAccess {
  id             String   @id @default(cuid())
  businessUserId String
  outletId       String
  createdAt      DateTime @default(now())

  businessUser BusinessUser @relation(fields: [businessUserId], references: [id], onDelete: Cascade)
  outlet       Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([businessUserId, outletId])
  @@index([outletId])
  @@map("business_user_outlet_accesses")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businesses BusinessFeatureFlag[]

  @@map("feature_flags")
}

model BusinessFeatureFlag {
  id            String   @id @default(cuid())
  businessId    String
  featureFlagId String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([businessId, featureFlagId])
  @@map("business_feature_flags")
}

model Category {
  id          String         @id @default(cuid())
  businessId  String
  name        String
  code        String?
  description String?
  sortOrder   Int            @default(0)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]
  promos   Promo[]

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@index([businessId, status])
  @@index([businessId, sortOrder])
  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  businessId  String
  categoryId  String?
  name        String
  code        String?
  sku         String?
  barcode     String?
  brand       String?
  unit        String?
  description String?
  imageUrl    String?
  basePrice   Decimal       @db.Decimal(14, 2)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business       Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  outletSettings ProductOutletSetting[]
  promos         Promo[]

  @@unique([businessId, code])
  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, status])
  @@index([businessId, categoryId])
  @@index([businessId, name])
  @@index([businessId, brand])
  @@index([businessId, unit])
  @@index([businessId, barcode])
  @@map("products")
}

model ProductOutletSetting {
  id            String              @id @default(cuid())
  productId     String
  outletId      String
  status        ProductOutletStatus @default(ACTIVE)
  isAvailable   Boolean             @default(true)
  priceOverride Decimal?            @db.Decimal(14, 2)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  outlet  Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([productId, outletId])
  @@index([outletId, status])
  @@index([productId, status])
  @@map("product_outlet_settings")
}

model OutletTable {
  id        String            @id @default(cuid())
  outletId  String
  name      String
  code      String
  capacity  Int?
  status    OutletTableStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, code])
  @@unique([outletId, name])
  @@index([outletId, status])
  @@map("outlet_tables")
}

model Promo {
  id              String            @id @default(cuid())
  businessId      String
  name            String
  description     String?
  targetType      PromoTargetType
  categoryId      String?
  productId       String?
  targetTextValue String?
  discountType    PromoDiscountType
  discountValue   Decimal           @db.Decimal(14, 2)
  startDate       DateTime
  endDate         DateTime
  startTime       String
  endTime         String
  status          PromoStatus       @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([businessId, targetType])
  @@index([businessId, startDate, endDate])
  @@index([categoryId])
  @@index([productId])
  @@map("promos")
}
