generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  fullName          String
  email             String             @unique
  passwordHash      String
  status            UserStatus         @default(ACTIVE)
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auditLogs         AuditLog[]         @relation("AuditLogActorUser")
  businessFeatureFlagOverrides BusinessFeatureFlagOverride[] @relation("BusinessFeatureFlagOverrideActorUser")
  businessUsers     BusinessUser[]
  ownedBusinesses   Business[]         @relation("BusinessOwner")
  platformRoles     UserPlatformRole[]
  platformAuditLogs PlatformAuditLog[] @relation("PlatformAuditLogActorUser")

  @@index([status])
  @@map("users")
}

model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  entityLabel String?
  summary     String?
  changes     Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  actorUser   User?    @relation("PlatformAuditLogActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, createdAt])
  @@index([actorUserId, createdAt])
  @@map("platform_audit_logs")
}

model PlatformRole {
  id          String             @id @default(cuid())
  code        PlatformRoleCode   @unique
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  userRoles   UserPlatformRole[]

  @@map("platform_roles")
}

model UserPlatformRole {
  id             String       @id @default(cuid())
  userId         String
  platformRoleId String
  createdAt      DateTime     @default(now())
  platformRole   PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platformRoleId])
  @@index([platformRoleId])
  @@map("user_platform_roles")
}

model FeatureFlag {
  id          String                @id @default(cuid())
  key         String                @unique
  name        String
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  businesses  BusinessFeatureFlag[]
  businessOverrides BusinessFeatureFlagOverride[]
  plans       PlanFeatureFlag[]

  @@map("feature_flags")
}

model PlanFeatureFlag {
  id            String      @id @default(cuid())
  planId        String
  featureFlagId String
  createdAt     DateTime    @default(now())
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  plan          Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureFlagId])
  @@index([featureFlagId])
  @@map("plan_feature_flags")
}

model Plan {
  id                     String                       @id @default(cuid())
  code                   String                       @unique
  name                   String
  description            String?
  monthlyPrice           Decimal                      @db.Decimal(14, 2)
  currencyCode           String                       @default("IDR")
  businessType           BusinessType?
  maxOutlets             Int?
  maxUsers               Int?
  maxProducts            Int?
  maxMonthlyTransactions Int?
  isActive               Boolean                      @default(true)
  isCustomPricing        Boolean                      @default(false)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  subscriptions          BusinessSubscription[]
  featureFlags           PlanFeatureFlag[]
  scheduleChangesFrom    SubscriptionScheduleChange[] @relation("SubscriptionScheduleChangeFromPlan")
  scheduleChangesTo      SubscriptionScheduleChange[] @relation("SubscriptionScheduleChangeToPlan")

  @@index([businessType, isActive])
  @@map("plans")
}

model Business {
  id                          String                       @id @default(cuid())
  name                        String
  slug                        String                       @unique
  businessType                BusinessType
  status                      BusinessStatus               @default(ACTIVE)
  ownerUserId                 String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  auditLogs                   AuditLog[]
  businessFeatures            BusinessFeatureFlag[]
  featureFlagOverrides        BusinessFeatureFlagOverride[]
  setting                     BusinessSetting?
  subscriptions               BusinessSubscription[]
  businessUsers               BusinessUser[]
  ownerUser                   User?                        @relation("BusinessOwner", fields: [ownerUserId], references: [id])
  categories                  Category[]
  goodsReceipts               GoodsReceipt[]
  inventoryItems              InventoryItem[]
  inventoryMovements          InventoryMovement[]
  orders                      Order[]
  outletPosChargeRules        OutletPosChargeRule[]
  outlets                     Outlet[]
  payments                    Payment[]
  products                    Product[]
  promos                      Promo[]
  purchaseOrders              PurchaseOrder[]
  purchasePriceHistories      PurchasePriceHistory[]
  purchaseReturns             PurchaseReturn[]
  receipts                    Receipt[]
  subscriptionInvoices        SubscriptionInvoice[]
  subscriptionScheduleChanges SubscriptionScheduleChange[]
  subscriptionUsageSnapshots  SubscriptionUsageMonthly[]
  supplierInvoices            SupplierInvoice[]
  supplierPayments            SupplierPayment[]
  supplierProducts            SupplierProduct[]
  suppliers                   Supplier[]

  @@index([businessType])
  @@index([status])
  @@map("businesses")
}

model BusinessSubscription {
  id                 String                       @id @default(cuid())
  businessId         String
  planId             String
  status             SubscriptionStatus           @default(TRIAL)
  startedAt          DateTime                     @default(now())
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  graceEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean                      @default(false)
  cancelledAt        DateTime?
  suspendedAt        DateTime?
  notes              String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  business           Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan               Plan                         @relation(fields: [planId], references: [id])
  invoices           SubscriptionInvoice[]
  scheduleChanges    SubscriptionScheduleChange[]

  @@index([businessId, status])
  @@index([businessId, currentPeriodEnd])
  @@index([planId])
  @@map("business_subscriptions")
}

model SubscriptionInvoice {
  id                 String                    @id @default(cuid())
  businessId         String
  subscriptionId     String
  invoiceNumber      String
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  subtotal           Decimal                   @default(0) @db.Decimal(14, 2)
  taxAmount          Decimal                   @default(0) @db.Decimal(14, 2)
  totalAmount        Decimal                   @default(0) @db.Decimal(14, 2)
  status             SubscriptionInvoiceStatus @default(DRAFT)
  dueDate            DateTime
  issuedAt           DateTime?
  paidAt             DateTime?
  voidedAt           DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  business           Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription       BusinessSubscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments           SubscriptionPayment[]

  @@unique([businessId, invoiceNumber])
  @@unique([subscriptionId, billingPeriodStart, billingPeriodEnd])
  @@index([businessId, status, dueDate])
  @@index([subscriptionId, status])
  @@map("subscription_invoices")
}

model SubscriptionPayment {
  id              String                    @id @default(cuid())
  invoiceId       String
  method          PaymentMethod
  amount          Decimal                   @db.Decimal(14, 2)
  status          SubscriptionPaymentStatus @default(PENDING)
  referenceNumber String?
  paidAt          DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  invoice         SubscriptionInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, status])
  @@index([paidAt])
  @@map("subscription_payments")
}

model SubscriptionUsageMonthly {
  id               String   @id @default(cuid())
  businessId       String
  yearMonth        String
  outletCount      Int      @default(0)
  userCount        Int      @default(0)
  productCount     Int      @default(0)
  transactionCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, yearMonth])
  @@index([yearMonth])
  @@map("subscription_usage_monthly")
}

model SubscriptionScheduleChange {
  id             String                           @id @default(cuid())
  businessId     String
  subscriptionId String?
  fromPlanId     String
  toPlanId       String
  type           SubscriptionScheduleChangeType
  effectiveAt    DateTime
  status         SubscriptionScheduleChangeStatus @default(PENDING)
  requestedAt    DateTime                         @default(now())
  processedAt    DateTime?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  business       Business                         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromPlan       Plan                             @relation("SubscriptionScheduleChangeFromPlan", fields: [fromPlanId], references: [id])
  subscription   BusinessSubscription?            @relation(fields: [subscriptionId], references: [id])
  toPlan         Plan                             @relation("SubscriptionScheduleChangeToPlan", fields: [toPlanId], references: [id])

  @@index([businessId, status, effectiveAt])
  @@index([subscriptionId])
  @@index([fromPlanId])
  @@index([toPlanId])
  @@map("subscription_schedule_changes")
}

model SubscriptionNotificationLog {
  id               String   @id @default(cuid())
  subscriptionId   String
  notificationType String
  periodEnd        DateTime
  sentAt           DateTime @default(now())
  recipientEmail   String

  @@unique([subscriptionId, notificationType, periodEnd])
  @@map("subscription_notification_logs")
}

model Outlet {
  id                     String                     @id @default(cuid())
  businessId             String
  name                   String
  code                   String
  address                String?
  phone                  String?
  status                 OutletStatus               @default(ACTIVE)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  auditLogs              AuditLog[]
  businessUserAccesses   BusinessUserOutletAccess[]
  goodsReceipts          GoodsReceipt[]
  inventoryItems         InventoryItem[]
  inventoryMovements     InventoryMovement[]
  orders                 Order[]
  outletPosChargeRules   OutletPosChargeRule[]
  receiptSetting         OutletReceiptSetting?
  roundingSetting        OutletRoundingSetting?
  setting                OutletSetting?
  tables                 OutletTable[]
  business               Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments               Payment[]
  productOutletSettings  ProductOutletSetting[]
  promoOutlets           PromoOutlet[]
  purchaseOrders         PurchaseOrder[]
  purchasePriceHistories PurchasePriceHistory[]
  purchaseReturns        PurchaseReturn[]
  receipts               Receipt[]
  supplierInvoices       SupplierInvoice[]
  supplierPayments       SupplierPayment[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("outlets")
}

model BusinessRole {
  id              String                   @id @default(cuid())
  code            BusinessRoleCode         @unique
  name            String
  description     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  rolePermissions BusinessRolePermission[]
  businessUsers   BusinessUser[]

  @@map("business_roles")
}

model BusinessPermission {
  id              String                   @id @default(cuid())
  code            BusinessPermissionCode   @unique
  name            String
  description     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  rolePermissions BusinessRolePermission[]

  @@map("business_permissions")
}

model BusinessRolePermission {
  id                   String             @id @default(cuid())
  businessRoleId       String
  businessPermissionId String
  createdAt            DateTime           @default(now())
  businessPermission   BusinessPermission @relation(fields: [businessPermissionId], references: [id], onDelete: Cascade)
  businessRole         BusinessRole       @relation(fields: [businessRoleId], references: [id], onDelete: Cascade)

  @@unique([businessRoleId, businessPermissionId])
  @@index([businessPermissionId])
  @@map("business_role_permissions")
}

model BusinessUser {
  id                        String                     @id @default(cuid())
  businessId                String
  userId                    String
  businessRoleId            String
  isPrimary                 Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  hasAllOutletAccess        Boolean                    @default(false)
  status                    BusinessUserStatus         @default(ACTIVE)
  auditLogs                 AuditLog[]                 @relation("AuditLogActorBusinessUser")
  outletAccesses            BusinessUserOutletAccess[]
  business                  Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessRole              BusinessRole               @relation(fields: [businessRoleId], references: [id])
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdInventoryMovements InventoryMovement[]        @relation("InventoryMovementCreatedByBusinessUser")
  createdOrders             Order[]                    @relation("OrderCreatedByBusinessUser")
  receivedPayments          Payment[]                  @relation("PaymentReceivedByBusinessUser")

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessRoleId])
  @@index([businessId, status])
  @@map("business_users")
}

model BusinessUserOutletAccess {
  id             String       @id @default(cuid())
  businessUserId String
  outletId       String
  createdAt      DateTime     @default(now())
  businessUser   BusinessUser @relation(fields: [businessUserId], references: [id], onDelete: Cascade)
  outlet         Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([businessUserId, outletId])
  @@index([outletId])
  @@map("business_user_outlet_accesses")
}

model BusinessFeatureFlag {
  id            String      @id @default(cuid())
  businessId    String
  featureFlagId String
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([businessId, featureFlagId])
  @@index([featureFlagId])
  @@map("business_feature_flags")
}

model BusinessFeatureFlagOverride {
  id            String      @id @default(cuid())
  businessId    String
  featureFlagId String
  enabled       Boolean
  reason        String?
  actorUserId   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  actorUser     User?       @relation("BusinessFeatureFlagOverrideActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([businessId, featureFlagId])
  @@index([featureFlagId])
  @@index([actorUserId])
  @@map("business_feature_flag_overrides")
}

model Category {
  id          String         @id @default(cuid())
  businessId  String
  name        String
  code        String
  description String?
  sortOrder   Int            @default(0)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]
  promos      Promo[]

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@index([businessId, status])
  @@index([businessId, sortOrder])
  @@map("categories")
}

model Product {
  id                     String                 @id @default(cuid())
  businessId             String
  categoryId             String?
  name                   String
  code                   String
  sku                    String?
  description            String?
  imageUrl               String?
  basePrice              Decimal                @db.Decimal(14, 2)
  status                 ProductStatus          @default(ACTIVE)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  brand                  String?
  unit                   String?
  barcode                String?
  goodsReceiptItems      GoodsReceiptItem[]
  inventoryItems         InventoryItem[]
  inventoryMovements     InventoryMovement[]
  orderItems             OrderItem[]
  productOutletSettings  ProductOutletSetting[]
  business               Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category               Category?              @relation(fields: [categoryId], references: [id])
  promos                 Promo[]
  purchaseOrderItems     PurchaseOrderItem[]
  purchasePriceHistories PurchasePriceHistory[]
  purchaseReturnItems    PurchaseReturnItem[]
  supplierProducts       SupplierProduct[]

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, status])
  @@index([businessId, categoryId])
  @@index([businessId, barcode])
  @@index([businessId, name])
  @@index([businessId, brand])
  @@index([businessId, unit])
  @@map("products")
}

model Supplier {
  id                     String                 @id @default(cuid())
  businessId             String
  code                   String
  name                   String
  status                 SupplierStatus         @default(ACTIVE)
  phone                  String?
  email                  String?
  address                String?
  paymentTermDays        Int?
  taxNumber              String?
  notes                  String?
  leadTimeDays           Int?
  isPreferred            Boolean                @default(false)
  lastOrderAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  goodsReceipts          GoodsReceipt[]
  purchaseOrders         PurchaseOrder[]
  purchasePriceHistories PurchasePriceHistory[]
  purchaseReturns        PurchaseReturn[]
  supplierInvoices       SupplierInvoice[]
  supplierPayments       SupplierPayment[]
  supplierProducts       SupplierProduct[]
  business               Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, code])
  @@unique([businessId, name])
  @@index([businessId, status])
  @@index([businessId, isPreferred])
  @@map("suppliers")
}

model PurchaseOrder {
  id                      String                 @id @default(cuid())
  businessId              String
  outletId                String
  supplierId              String
  createdByBusinessUserId String
  poNumber                String                 @unique
  orderDate               DateTime
  expectedDate            DateTime?
  notes                   String?
  status                  PurchaseOrderStatus    @default(DRAFT)
  subtotal                Decimal                @default(0) @db.Decimal(14, 2)
  totalAmount             Decimal                @default(0) @db.Decimal(14, 2)
  submittedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  goodsReceipts           GoodsReceipt[]
  items                   PurchaseOrderItem[]
  business                Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet                  Outlet                 @relation(fields: [outletId], references: [id], onDelete: Cascade)
  supplier                Supplier               @relation(fields: [supplierId], references: [id])
  purchasePriceHistories  PurchasePriceHistory[]
  supplierInvoices        SupplierInvoice[]

  @@index([businessId, outletId, status])
  @@index([businessId, supplierId])
  @@index([outletId, orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                     String                 @id @default(cuid())
  purchaseOrderId        String
  productId              String
  productName            String
  productCode            String?
  productSku             String?
  productBarcode         String?
  unit                   String?
  quantityOrdered        Decimal                @db.Decimal(14, 3)
  quantityReceived       Decimal                @default(0) @db.Decimal(14, 3)
  unitCost               Decimal                @db.Decimal(14, 2)
  lineSubtotal           Decimal                @default(0) @db.Decimal(14, 2)
  note                   String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  goodsReceiptItems      GoodsReceiptItem[]
  product                Product                @relation(fields: [productId], references: [id])
  purchaseOrder          PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchasePriceHistories PurchasePriceHistory[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                      String                 @id @default(cuid())
  businessId              String
  outletId                String
  supplierId              String
  purchaseOrderId         String?
  createdByBusinessUserId String
  postedByBusinessUserId  String?
  receiptNumber           String                 @unique
  receiptDate             DateTime
  supplierInvoiceNumber   String?
  notes                   String?
  status                  GoodsReceiptStatus     @default(DRAFT)
  subtotal                Decimal                @default(0) @db.Decimal(14, 2)
  totalAmount             Decimal                @default(0) @db.Decimal(14, 2)
  postedAt                DateTime?
  voidedAt                DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  items                   GoodsReceiptItem[]
  business                Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet                  Outlet                 @relation(fields: [outletId], references: [id], onDelete: Cascade)
  purchaseOrder           PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id])
  supplier                Supplier               @relation(fields: [supplierId], references: [id])
  purchasePriceHistories  PurchasePriceHistory[]
  purchaseReturns         PurchaseReturn[]
  supplierInvoice         SupplierInvoice?

  @@index([businessId, outletId, status])
  @@index([businessId, supplierId])
  @@index([purchaseOrderId])
  @@index([outletId, receiptDate])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                   String                @id @default(cuid())
  goodsReceiptId       String
  purchaseOrderItemId  String?
  productId            String
  productName          String
  productCode          String?
  productSku           String?
  productBarcode       String?
  unit                 String?
  quantityReceived     Decimal               @db.Decimal(14, 3)
  quantityAccepted     Decimal               @db.Decimal(14, 3)
  quantityRejected     Decimal               @default(0) @db.Decimal(14, 3)
  unitCost             Decimal               @db.Decimal(14, 2)
  lineSubtotal         Decimal               @default(0) @db.Decimal(14, 2)
  note                 String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  quantityReturned     Decimal               @default(0) @db.Decimal(14, 3)
  goodsReceipt         GoodsReceipt          @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product              Product               @relation(fields: [productId], references: [id])
  purchaseOrderItem    PurchaseOrderItem?    @relation(fields: [purchaseOrderItemId], references: [id])
  purchasePriceHistory PurchasePriceHistory?
  purchaseReturnItems  PurchaseReturnItem[]

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([productId])
  @@map("goods_receipt_items")
}

model PurchasePriceHistory {
  id                  String             @id @default(cuid())
  businessId          String
  outletId            String
  supplierId          String
  productId           String
  goodsReceiptId      String
  goodsReceiptItemId  String             @unique
  purchaseOrderId     String?
  purchaseOrderItemId String?
  effectiveDate       DateTime
  quantity            Decimal            @db.Decimal(14, 3)
  unitCost            Decimal            @db.Decimal(14, 2)
  createdAt           DateTime           @default(now())
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  goodsReceiptItem    GoodsReceiptItem   @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Cascade)
  outlet              Outlet             @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [productId], references: [id])
  purchaseOrder       PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  supplier            Supplier           @relation(fields: [supplierId], references: [id])

  @@index([businessId, outletId, effectiveDate])
  @@index([businessId, productId, effectiveDate])
  @@index([businessId, supplierId, effectiveDate], map: "purchase_price_histories_businessId_supplierId_effectiveDate_id")
  @@index([goodsReceiptId])
  @@index([purchaseOrderId])
  @@index([purchaseOrderItemId])
  @@map("purchase_price_histories")
}

model SupplierProduct {
  id                String   @id @default(cuid())
  businessId        String
  supplierId        String
  productId         String
  supplierSku       String?
  lastPurchasePrice Decimal? @db.Decimal(14, 2)
  minimumOrderQty   Decimal? @db.Decimal(14, 3)
  isPrimarySupplier Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([businessId, supplierId])
  @@index([businessId, productId])
  @@index([productId, isPrimarySupplier])
  @@map("supplier_products")
}

model SupplierInvoice {
  id                      String                @id @default(cuid())
  businessId              String
  outletId                String
  supplierId              String
  goodsReceiptId          String?               @unique
  purchaseOrderId         String?
  createdByBusinessUserId String
  invoiceNumber           String
  invoiceDate             DateTime
  dueDate                 DateTime?
  notes                   String?
  status                  SupplierInvoiceStatus @default(UNPAID)
  grandTotal              Decimal               @db.Decimal(14, 2)
  paidAmount              Decimal               @default(0) @db.Decimal(14, 2)
  outstandingAmount       Decimal               @db.Decimal(14, 2)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  purchaseReturns         PurchaseReturn[]
  business                Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  goodsReceipt            GoodsReceipt?         @relation(fields: [goodsReceiptId], references: [id])
  outlet                  Outlet                @relation(fields: [outletId], references: [id], onDelete: Cascade)
  purchaseOrder           PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  supplier                Supplier              @relation(fields: [supplierId], references: [id])
  payments                SupplierPayment[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, outletId, status])
  @@index([businessId, supplierId])
  @@index([purchaseOrderId])
  @@map("supplier_invoices")
}

model SupplierPayment {
  id                   String          @id @default(cuid())
  supplierInvoiceId    String
  businessId           String
  outletId             String
  supplierId           String
  paidByBusinessUserId String
  paymentNumber        String          @unique
  method               PaymentMethod
  amount               Decimal         @db.Decimal(14, 2)
  paymentDate          DateTime
  referenceNumber      String?
  note                 String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  business             Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet               Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  supplier             Supplier        @relation(fields: [supplierId], references: [id])
  invoice              SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)

  @@index([supplierInvoiceId])
  @@index([businessId, outletId, paymentDate])
  @@index([businessId, supplierId, paymentDate])
  @@map("supplier_payments")
}

model PurchaseReturn {
  id                      String               @id @default(cuid())
  businessId              String
  outletId                String
  supplierId              String
  goodsReceiptId          String
  supplierInvoiceId       String?
  createdByBusinessUserId String
  postedByBusinessUserId  String?
  returnNumber            String               @unique
  returnDate              DateTime
  reason                  String?
  notes                   String?
  status                  PurchaseReturnStatus @default(DRAFT)
  subtotal                Decimal              @default(0) @db.Decimal(14, 2)
  totalAmount             Decimal              @default(0) @db.Decimal(14, 2)
  postedAt                DateTime?
  voidedAt                DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  items                   PurchaseReturnItem[]
  business                Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  goodsReceipt            GoodsReceipt         @relation(fields: [goodsReceiptId], references: [id])
  outlet                  Outlet               @relation(fields: [outletId], references: [id], onDelete: Cascade)
  supplier                Supplier             @relation(fields: [supplierId], references: [id])
  supplierInvoice         SupplierInvoice?     @relation(fields: [supplierInvoiceId], references: [id])

  @@index([businessId, outletId, status])
  @@index([businessId, supplierId])
  @@index([goodsReceiptId])
  @@index([supplierInvoiceId])
  @@index([outletId, returnDate])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id                 String           @id @default(cuid())
  purchaseReturnId   String
  goodsReceiptItemId String
  productId          String
  productName        String
  productCode        String?
  productSku         String?
  productBarcode     String?
  unit               String?
  quantityReturned   Decimal          @db.Decimal(14, 3)
  unitCost           Decimal          @db.Decimal(14, 2)
  lineSubtotal       Decimal          @default(0) @db.Decimal(14, 2)
  note               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  goodsReceiptItem   GoodsReceiptItem @relation(fields: [goodsReceiptItemId], references: [id])
  product            Product          @relation(fields: [productId], references: [id])
  purchaseReturn     PurchaseReturn   @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  @@index([purchaseReturnId])
  @@index([goodsReceiptItemId])
  @@index([productId])
  @@map("purchase_return_items")
}

model ProductOutletSetting {
  id            String              @id @default(cuid())
  productId     String
  outletId      String
  status        ProductOutletStatus @default(ACTIVE)
  isAvailable   Boolean             @default(true)
  priceOverride Decimal?            @db.Decimal(14, 2)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  outlet        Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, outletId])
  @@index([outletId, status])
  @@index([productId, status])
  @@map("product_outlet_settings")
}

model OutletTable {
  id        String            @id @default(cuid())
  outletId  String
  name      String
  code      String
  capacity  Int?
  status    OutletTableStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  orders    Order[]
  outlet    Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, code])
  @@unique([outletId, name])
  @@index([outletId, status])
  @@map("outlet_tables")
}

model Order {
  id                      String        @id @default(cuid())
  businessId              String
  outletId                String
  createdByBusinessUserId String
  tableId                 String?
  orderNumber             String        @unique
  notes                   String?
  status                  OrderStatus   @default(DRAFT)
  paymentStatus           PaymentStatus @default(UNPAID)
  subtotal                Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount          Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount               Decimal       @default(0) @db.Decimal(14, 2)
  serviceChargeAmount     Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount             Decimal       @default(0) @db.Decimal(14, 2)
  submittedAt             DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  items                   OrderItem[]
  business                Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByBusinessUser   BusinessUser  @relation("OrderCreatedByBusinessUser", fields: [createdByBusinessUserId], references: [id])
  outlet                  Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  table                   OutletTable?  @relation(fields: [tableId], references: [id])
  payments                Payment[]
  receipt                 Receipt?

  @@index([businessId, outletId, status])
  @@index([businessId, outletId, paymentStatus])
  @@index([outletId, createdAt])
  @@index([businessId, createdAt], map: "orders_business_createdAt_idx")
  @@index([businessId, outletId, createdAt], map: "orders_business_outlet_createdAt_idx")
  @@index([createdByBusinessUserId])
  @@index([tableId])
  @@map("orders")
}

model OrderItem {
  id                 String          @id @default(cuid())
  orderId            String
  productId          String
  productName        String
  productCode        String?
  productSku         String?
  productBarcode     String?
  unitPrice          Decimal         @db.Decimal(14, 2)
  quantity           Decimal         @default(1) @db.Decimal(14, 2)
  note               String?
  lineSubtotal       Decimal         @default(0) @db.Decimal(14, 2)
  lineDiscountAmount Decimal         @default(0) @db.Decimal(14, 2)
  lineTotal          Decimal         @default(0) @db.Decimal(14, 2)
  status             OrderItemStatus @default(PENDING)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id])

  @@index([orderId, status])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                       String        @id @default(cuid())
  orderId                  String
  businessId               String
  outletId                 String
  receivedByBusinessUserId String
  paymentNumber            String        @unique
  method                   PaymentMethod @default(CASH)
  status                   PaymentStatus @default(PAID)
  amountPaid               Decimal       @db.Decimal(14, 2)
  amountTendered           Decimal?      @db.Decimal(14, 2)
  changeAmount             Decimal       @default(0) @db.Decimal(14, 2)
  note                     String?
  paidAt                   DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  business                 Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order                    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  outlet                   Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  receivedByBusinessUser   BusinessUser  @relation("PaymentReceivedByBusinessUser", fields: [receivedByBusinessUserId], references: [id])
  receipt                  Receipt?

  @@index([orderId])
  @@index([businessId, outletId, status])
  @@index([outletId, paidAt])
  @@index([receivedByBusinessUserId])
  @@map("payments")
}

model Receipt {
  id              String    @id @default(cuid())
  orderId         String    @unique
  paymentId       String?   @unique
  businessId      String
  outletId        String
  receiptNumber   String    @unique
  businessName    String
  outletName      String
  outletAddress   String?
  issuedAt        DateTime
  printedAt       DateTime?
  contentSnapshot Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  outlet          Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  payment         Payment?  @relation(fields: [paymentId], references: [id])

  @@index([businessId, outletId, issuedAt])
  @@index([outletId, issuedAt])
  @@map("receipts")
}

model Promo {
  id              String            @id @default(cuid())
  businessId      String
  name            String
  description     String?
  targetType      PromoTargetType
  categoryId      String?
  productId       String?
  targetTextValue String?
  discountType    PromoDiscountType
  discountValue   Decimal           @db.Decimal(14, 2)
  startDate       DateTime
  endDate         DateTime
  startTime       String
  endTime         String
  status          PromoStatus       @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  outletScope     PromoOutletScope  @default(ALL_OUTLETS)
  promoOutlets    PromoOutlet[]
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category        Category?         @relation(fields: [categoryId], references: [id])
  product         Product?          @relation(fields: [productId], references: [id])

  @@index([businessId, status])
  @@index([businessId, targetType])
  @@index([businessId, startDate, endDate])
  @@index([businessId, outletScope])
  @@index([categoryId])
  @@index([productId])
  @@map("promos")
}

model PromoOutlet {
  id        String   @id @default(cuid())
  promoId   String
  outletId  String
  createdAt DateTime @default(now())
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  promo     Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@unique([promoId, outletId])
  @@index([promoId])
  @@index([outletId])
