model Order {
  id                      String        @id @default(cuid())
  businessId              String
  outletId                String
  createdByBusinessUserId String
  tableId                 String?
  orderNumber             String        @unique
  notes                   String?
  status                  OrderStatus   @default(DRAFT)
  paymentStatus           PaymentStatus @default(UNPAID)
  subtotal                Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount          Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount               Decimal       @default(0) @db.Decimal(14, 2)
  serviceChargeAmount     Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount             Decimal       @default(0) @db.Decimal(14, 2)
  submittedAt             DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  business              Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet                Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  createdByBusinessUser BusinessUser @relation("OrderCreatedByBusinessUser", fields: [createdByBusinessUserId], references: [id], onDelete: Restrict)
  table                 OutletTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  payments              Payment[]
  receipt               Receipt?

  @@index([businessId, outletId, status])
  @@index([businessId, outletId, paymentStatus])
  @@index([outletId, createdAt])
  @@index([businessId, createdAt], map: "orders_business_createdAt_idx")
  @@index([businessId, outletId, createdAt], map: "orders_business_outlet_createdAt_idx")
  @@index([createdByBusinessUserId])
  @@index([tableId])
  @@map("orders")
}

