  item                    InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  outlet                  Outlet                @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product                 Product               @relation(fields: [productId], references: [id])

  @@index([businessId, outletId])
  @@index([productId])
  @@index([createdAt])
  @@map("inventory_movements")
}

model AuditLog {
  id                  String        @id @default(cuid())
  businessId          String
  outletId            String?
  actorUserId         String?
  actorBusinessUserId String?
  action              String
  entityType          String
  entityId            String?
  entityLabel         String?
  summary             String?
  changes             Json?
  metadata            Json?
  createdAt           DateTime      @default(now())
  actorBusinessUser   BusinessUser? @relation("AuditLogActorBusinessUser", fields: [actorBusinessUserId], references: [id])
  actorUser           User?         @relation("AuditLogActorUser", fields: [actorUserId], references: [id])
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet              Outlet?       @relation(fields: [outletId], references: [id])

  @@index([businessId, createdAt])
  @@index([outletId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
  @@map("audit_logs")
}

